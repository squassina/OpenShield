# GEMINI_API_KEY: Required for optional sanitized Cloud AI second-opinion calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OpenShield Local Persistence (SQLite WAL)
OPENSHIELD_DB_PATH=".openshield-data/openshield.sqlite3"

# OpenShield Node (FastAPI) & OpenWrt Read-Only Connector (Server-side only)
OPENSHIELD_NODE_URL="http://192.168.1.10:8000"
OPENSHIELD_OPENWRT_URL="https://192.168.1.1/ubus"
OPENSHIELD_OPENWRT_USERNAME="openshield"
OPENSHIELD_OPENWRT_PASSWORD=""

# DNS Privacy Adapters (Server-side only)
OPENSHIELD_PIHOLE_URL="http://192.168.1.12"
OPENSHIELD_PIHOLE_PASSWORD=""
OPENSHIELD_ADGUARD_URL="http://192.168.20.12"
OPENSHIELD_ADGUARD_USERNAME=""
OPENSHIELD_ADGUARD_PASSWORD=""

# Local-First AI Runtime (Ollama)
OPENSHIELD_OLLAMA_URL="http://127.0.0.1:11434"
OPENSHIELD_OLLAMA_MODEL="llama3.1:8b"
